{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clawd",
  "version": "0.2.3",
  "identifier": "com.clawd.pet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clawd",
        "width": 200,
        "height": 200,
        "x": 1000,
        "y": 600,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": true,
        "fullscreen": false,
        "focus": false
      },
      {
        "label": "assistant",
        "title": "Clawd Assistant",
        "url": "assistant.html",
        "width": 360,
        "height": 380,
        "x": 700,
        "y": 500,
        "visible": false,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; object-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; base-uri 'self'; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "NM Developers",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
